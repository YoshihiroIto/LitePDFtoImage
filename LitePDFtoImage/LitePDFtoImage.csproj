<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.156.0" />

        <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8152" Condition="$([MSBuild]::IsOsPlatform('Windows'))" />
        <PackageReference Include="bblanchon.PDFium.macOS" Version="159.0.8152" Condition="$([MSBuild]::IsOsPlatform('OSX'))"/>
        <PackageReference Include="bblanchon.PDFium.Linux" Version="159.0.8152" Condition="$([MSBuild]::IsOsPlatform('Linux'))"/>
    </ItemGroup>
</Project>
